# Sample local values for Wombat Helm deployment
# Equivalent to pulumi/Pulumi.local.yaml.dist

environment: local

image:
  tag: "0.23.0"

# Sidecar dependencies for emissions calculations
dependencies:
  boaviztapi:
    type: CONTAINER
    # type: EXTERNAL
    # endpoint: "https://api.boavizta.org/v1/"
  ecologits:
    type: CONTAINER
    # type: EXTERNAL
    # endpoint: "https://api.ecologits.ai/"

# Application configuration
config:
  monitor:
    heartbeat: "10s"
  ui:
    maxDateRange:
      duration: 1
      unit: YEARS

# Metric compaction
compaction:
  cron: "0 1 * * * ?"
  window: "1h"
  delay: "1m"

# Optional: secrets set with the deployment, mounted under /secrets as the app's directory secret resolver
#secrets:
#  provisioned:
#    kubeconfig-my-cluster: CHANGEME  # the kubeconfig referenced by the kubernetes-api asset below

security:
  enabled: true
  oidc:
    auth-server-url: https://idp.example.com
    client-id: CHANGEME
    credentials:
      # Set exactly one; existingSecret avoids storing the credential in Helm release metadata.
      secret: CHANGEME
      existingSecret: ""
    authentication:
      scopes:
        - email
        - profile
      user-info-required: true
      extra-params:
        prompt: select_account
  auth:
    allowed-email-domains: [example.com]
    email-claim: email
    require-verified-email: true
    display-name-claims: [email, name, preferred_username]
    idp-logout: true
    roles:
      admin: [wombat-admins]
      user: [wombat-users]

# Dynamic extensions storage
# extensions:
#   enabled: true
#   # Option A: Reference an existing PVC
#   existingClaim: my-extensions-pvc
#   # Option B: Provision a managed PVC
#   storageClassName: standard
#   size: 1Gi
#   mountPath: /extensions

# Optional: environments provisioned at startup, read-only in the app. Without them, environments are created
# from the dashboard or the API.
#monitoredEnvironments:
#  environments:
#    test:
#      assets:
#        - type: tech.illuin.wombat-module.kubernetes-api
#          id: my-cluster
#          kubeconfig-key: kubeconfig-my-cluster  # a key of secrets.provisioned
#          namespace: my-namespace
#          profile:
#            provider: aws
#            instance-type: c5a.4xlarge
#            location: FRA
#            lifespan: 5y
#        - type: tech.illuin.wombat-module.llm-static
#          id: my-llm
#          profile:
#            zone-id: Europe/Paris
#            models:
#              - provider: mistralai
#                model: mistral-large-latest
#                location: FRA
#                request-per-year: 9125000  # ~1000 users * 5 calls * 5 inferences * 365
#                output-token-per-request: 300
#                scenarios:
#                  - type: user_activity
#                    opening-time: "08:00:00"
#                    closing-time: "18:00:00"

# Persistence configuration
persistence:
  type: SQLITE_WITH_BACKUP
  backup:
    enabled: true
    cron: "0 0 2 * * ?"
    restoreOnStartup: true
    cleanup:
      cron: "0 0 3 * * ?"
      retainLast: 25
    s3:
      endpoint: "CHANGEME"
      bucket: "wombat"
      region: "CHANGEME"
      keyPrefix: "test/sqlite/"
      accessKey: "CHANGEME"
      secretKey: "CHANGEME"
