config:
  wombat:service:
    namespace: my-namespace
    environment: local
    container:
      imageVersion: 0.23.0
      # optional pull secret, to be removed once images move to a public registry:
      #   pulumi config set --secret --path 'service.container.pullSecret.serviceAccount' <gcr-service-account-json>
      #pullSecret:
      #  type: GAR
      #  registry: europe-docker.pkg.dev
      #  serviceAccount: CHANGEME
    dependencies:
      boaviztapi:
        type: CONTAINER
        #type: EXTERNAL
        #endpoint: "https://api.boavizta.org/v1/"
      ecologits:
        type: CONTAINER
        #type: EXTERNAL
        #endpoint: "https://api.ecologits.ai/"
    config:
      monitor:
        heartbeat: "10s"
    compaction:
      cron: "0 1 * * * ?"
      window: "1h"
      delay: "1m"
    ui:
      maxDateRange: { duration: 1, unit: YEARS }

    security:
      enabled: false
      # To enable OIDC, set enabled to true and configure oidc below:
      #oidc:
      #  authServerUrl: https://idp.example.com
      #  clientId: wombat
      #  # Store this as a Pulumi secret:
      #  #   pulumi config set --secret --path 'service.security.oidc.clientSecret' <client-secret>
      #  clientSecret: CHANGEME
      #  # Or reference an existing Kubernetes Secret with a client-secret key:
      #  # existingSecret: wombat-oidc-client
      #  authentication:
      #    scopes: [email, profile]
      #    userInfoRequired: true
      #    extraParams:
      #      prompt: select_account
      #auth:
      #  allowedEmailDomains: [example.com]
      #  emailClaim: email
      #  requireVerifiedEmail: true
      #  displayNameClaims: [email, name, preferred_username]
      #  idpLogout: true
      #  roles:
      #    admin: [wombat-admins]
      #    user: [wombat-users]
    # Optional: secrets set with the deployment, mounted under /secrets as the app's directory secret resolver
    #secrets:
    #  provisioned:
    #    # the kubeconfig referenced by the kubernetes-api asset below, set as a secret via:
    #    #   pulumi config set --secret --path 'service.secrets.provisioned.kubeconfig-my-cluster' -- "$(cat ~/.kube/my-cluster.config)"
    #    kubeconfig-my-cluster: CHANGEME
    #extensions:
    #  # Mount user-provided JAR extensions into /extensions via PVC:
    #  # Option A: Reference an existing PVC
    #  existingClaimName: my-extensions-pvc
    #  # Option B: Provision a managed PVC
    #  pvc:
    #    size: 1Gi
    #    storageClassName: standard
    #    accessModes:
    #      - ReadWriteOnce
    #  # Optional custom mount path (defaults to /extensions):
    #  mountPath: /extensions
    # Optional: environments provisioned at startup, read-only in the app. Without them, environments are created
    # from the dashboard or the API.
    #monitoredEnvironments:
    #  environments:
    #    test:
    #      assets:
    #        - type: tech.illuin.wombat-module.kubernetes-api
    #          id: my-cluster
    #          kubeconfig-key: kubeconfig-my-cluster  # a key of secrets.provisioned
    #          namespace: my-namespace
    #          profile:
    #            provider: aws
    #            instance-type: c5a.4xlarge
    #            location: FRA
    #            lifespan: 5y
    #        - type: tech.illuin.wombat-module.llm-static
    #          id: my-llm
    #          profile:
    #            zone-id: Europe/Paris
    #            models:
    #              - provider: mistralai
    #                model: mistral-large-latest
    #                location: FRA
    #                request-per-year: 9125000  # ~1000 users * 5 calls * 5 inferences * 365
    #                output-token-per-request: 300
    #                scenarios:
    #                  - type: user_activity
    #                    opening-time: "08:00:00"
    #                    closing-time: "18:00:00"
    persistence:
      type: SQLITE_WITH_BACKUP
      backup:
        cron: "0 0 2 * * ?"
        restoreOnStartup: true
        cleanup:
          cron: "0 0 3 * * ?"
          retainLast: 25
        s3:
          endpoint: "CHANGEME"
          bucket: "wombat"
          region: "CHANGEME"
          keyPrefix: "test/sqlite/"
          accessKey: "CHANGEME"
          # secretKey should be a secret, set via:
          #   pulumi config set --secret --path 'service.persistence.backup.s3.secretKey' <value>
          secretKey: "CHANGEME"
