config:
  wombat:service:
    namespace: my-namespace
    environment: local
    container:
      imageVersion: 0.27.0
      # optional pull secret, to be removed once images move to a public registry:
      #   pulumi config set --secret --path 'service.container.pullSecret.serviceAccount' <gcr-service-account-json>
      #pullSecret:
      #  type: GAR
      #  registry: europe-docker.pkg.dev
      #  serviceAccount: CHANGEME
    mode:
      type: standalone
      #type: aggregator
      #type: worker
      #id: east
      #aggregator:
      #  url: "https://wombat-aggregator.example.com"
      #  # apiKey should be a secret, set via:
      #  #   pulumi config set --secret --path 'service.mode.aggregator.apiKey' <value>
      #  apiKey: CHANGEME
    dependencies:
      boaviztapi:
        type: CONTAINER
        #type: EXTERNAL
        #endpoint: "https://api.boavizta.org/v1/"
      ecologits:
        type: CONTAINER
        #type: EXTERNAL
        #endpoint: "https://api.ecologits.ai/"
    config:
      monitor:
        heartbeat: "10s"
    compaction:
      cron: "0 1 * * * ?"
      window: "1h"
      delay: "1m"
    ui:
      maxDateRange: { duration: 1, unit: YEARS }

    # Optional: OIDC authentication
    #security:
    #  enabled: true
    #  oidc:
    #    authServerUrl: https://idp.example.com
    #    clientId: wombat
    #    # set as a secret via:
    #    #   pulumi config set --secret --path 'service.security.oidc.credentials.secret' <client-secret>
    #    credentials:
    #      secret: CHANGEME
    #    authentication:
    #      scopes: [email, profile]
    #      userInfoRequired: true
    #      extraParams:
    #        prompt: select_account
    #  auth:
    #    allowedEmailDomains: [example.com]
    #    emailClaim: email
    #    requireVerifiedEmail: true
    #    displayNameClaims: [email, name, preferred_username]
    #    idpLogout: true
    #    roles:
    #      admin: [wombat-admins]
    #      user: [wombat-users]
    # Optional: the secret backends the app resolves secret keys from
    #secrets:
    #  # Secrets set with the deployment, mounted under /secrets as the app's directory secret resolver
    #  provisioned:
    #    # the kubeconfig referenced by the kubernetes-api asset below, set as a secret via:
    #    #   pulumi config set --secret --path 'service.secrets.provisioned.kubeconfig-my-cluster' -- "$(cat ~/.kube/my-cluster.config)"
    #    kubeconfig-my-cluster: CHANGEME
    #  # Existing Secrets of the namespace, mounted next to them
    #  existingSecrets: [my-external-secrets]
    #  # The backend behind /api/secrets: turn on security with it
    #  writeMode: database
    #  database:
    #    activeKekId: current
    #    kek:
    #      # set as a secret via:
    #      #   pulumi config set --secret --path 'service.secrets.database.kek.current' "$(openssl rand -base64 32)"
    #      current: CHANGEME
    #  # Vault, read-only unless writeMode is vault
    #  vault:
    #    enabled: true
    #    client:
    #      url: https://vault.example.com
    #      authentication:
    #        kubernetes:
    #          role: wombat  # bound to the pod's ServiceAccount
    #  cache:
    #    ttl: 10m
    #extensions:
    #  # Mount user-provided JAR extensions into /extensions via PVC:
    #  # Option A: Reference an existing PVC
    #  existingClaimName: my-extensions-pvc
    #  # Option B: Provision a managed PVC
    #  pvc:
    #    size: 1Gi
    #    storageClassName: standard
    #    accessModes:
    #      - ReadWriteOnce
    #  # Optional custom mount path (defaults to /extensions):
    #  mountPath: /extensions
    # Optional: environments provisioned at startup, read-only in the app. Without them, environments are created
    # from the dashboard or the API.
    #monitoredEnvironments:
    #  environments:
    #    test:
    #      assets:
    #        - type: tech.illuin.wombat-module.kubernetes-api
    #          id: my-cluster
    #          kubeconfig-key: kubeconfig-my-cluster  # a key of secrets.provisioned
    #          namespace: my-namespace
    #          profile:
    #            provider: aws
    #            instance-type: c5a.4xlarge
    #            location: FRA
    #            lifespan: 5y
    #        - type: tech.illuin.wombat-module.llm-static
    #          id: my-llm
    #          profile:
    #            zone-id: Europe/Paris
    #            models:
    #              - provider: mistralai
    #                model: mistral-large-latest
    #                location: FRA
    #                request-per-year: 9125000  # ~1000 users * 5 calls * 5 inferences * 365
    #                output-token-per-request: 300
    #                scenarios:
    #                  - type: user_activity
    #                    opening-time: "08:00:00"
    #                    closing-time: "18:00:00"
    persistence:
      type: SQLITE_WITH_BACKUP
      backup:
        cron: "0 0 2 * * ?"
        restoreOnStartup: true
        cleanup:
          cron: "0 0 3 * * ?"
          retainLast: 25
        s3:
          endpoint: "CHANGEME"
          bucket: "wombat"
          region: "CHANGEME"
          keyPrefix: "test/sqlite/"
          accessKey: "CHANGEME"
          # secretKey should be a secret, set via:
          #   pulumi config set --secret --path 'service.persistence.backup.s3.secretKey' <value>
          secretKey: "CHANGEME"
